{
  "comment": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "onEnterRules": [
    {
      "beforeText": "^Host\\s",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^Match\\s",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*$",
      "action": { "indent": "outdent" }
    }
  ]
}
